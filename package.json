{
  "name": "stellarium-resource-registry",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "turbo": "^2.11.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2"
    }
  }
}
