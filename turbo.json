{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "API_URL"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "SYNC_NODE_URL",
        "SYNC_INTERVAL_MS",
        "GRANT_PROBE_INTERVAL_MS",
        "ADMIN_API_KEY",
        "WEB_ORIGIN",
        "PORT",
        "API_URL",
        "HOST",
        "BASE_URL",
        "STARTING_PEER"
      ]
    }
  }
}
