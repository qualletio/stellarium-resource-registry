DATABASE_URL=postgresql://registry:local-only-password@127.0.0.1:5432/registry
# The Stellarium node to sync resources from. apps/local-source-node runs one on :3100.
SYNC_NODE_URL=http://127.0.0.1:3100
SYNC_INTERVAL_MS=7200000
GRANT_PROBE_INTERVAL_MS=3600000
# Bearer token for POST /v1/sync. Leave unset to disable manual syncs.
ADMIN_API_KEY=
WEB_ORIGIN=http://localhost:3000
PORT=4000
