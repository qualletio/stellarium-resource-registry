{
  "name": "local-source-node",
  "private": true,
  "version": "0.0.0",
  "description": "The local Stellarium node the registry syncs from. Bootstraps from the peer node and issues grants on request.",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "biome lint src",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@registry/node-fixtures": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
